config_version=5

[application]
config/name="Antila | Kowloon Bus"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
config/description="A small Hong Kong bus driving experience."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="Antila"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.66, 0.77, 0.8, 1)

[physics]
3d/physics_engine="Jolt Physics"
jolt_physics_3d/motion_queries/use_enhanced_internal_edge_removal=true
common/physics_ticks_per_second=60
