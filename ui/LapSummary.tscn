[gd_scene load_steps=2 format=3 uid="uid://lap_summary_ui"]

[ext_resource type="Script" path="res://ui/LapSummaryUI.cs" id="1_lap_summary_ui"]

[node name="LapSummary" type="CanvasLayer"]
script = ExtResource("1_lap_summary_ui")

[node name="Panel" type="Panel" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -250.0
offset_top = -150.0
offset_right = 250.0
offset_bottom = 150.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
text = "Lap Complete!"
horizontal_alignment = 1
vertical_alignment = 1

[node name="LapTimeLabel" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
text = "Lap Time: 0.00s"
horizontal_alignment = 1

[node name="OffRoadLabel" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
text = "Off-Road Events: 0"
horizontal_alignment = 1

[node name="CollisionLabel" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
text = "Collisions: 0"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Panel/VBoxContainer"]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2

[node name="RestartButton" type="Button" parent="Panel/VBoxContainer"]
layout_mode = 2
text = "Restart Lap"

[node name="QuitButton" type="Button" parent="Panel/VBoxContainer"]
layout_mode = 2
text = "Quit"

[connection signal="pressed" from="Panel/VBoxContainer/RestartButton" to="." method="OnRestartPressed"]
[connection signal="pressed" from="Panel/VBoxContainer/QuitButton" to="." method="OnQuitPressed"]
